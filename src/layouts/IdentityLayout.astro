---
import '../styles/global.css';
const { celebration } = Astro.props;
const description = `A curated ${celebration} celebration kit by Celebration In A Box.`;
const themes = {
  birthday: { bg: 'bg-gradient-to-br from-[#1a1408] via-[#2a1f0f] to-[#1c1005]', text: 'text-amber-50', accent: 'bg-amber-400', gradient: 'from-amber-700 via-yellow-800 to-orange-900' },
  anniversary: { bg: 'bg-gradient-to-br from-[#1a0d12] via-[#2a1219] to-[#14080c]', text: 'text-rose-50', accent: 'bg-rose-500', gradient: 'from-rose-700 via-pink-800 to-red-900' },
  congratulations: { bg: 'bg-gradient-to-br from-[#0d1120] via-[#131a2e] to-[#08101f]', text: 'text-sky-50', accent: 'bg-sky-500', gradient: 'from-sky-700 via-blue-800 to-indigo-900' },
};
const theme = themes[celebration];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{celebration} | Celebration In A Box</title>
		<meta name="description" content={description} />
	</head>
	<body class={`${theme.bg} ${theme.text} transition-colors duration-1000 overflow-x-hidden min-h-screen flex items-center justify-center`}>
		<slot />
	</body>
</html>
