---
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<style>
			@tailwind base;
			@tailwind components;
			@tailwind utilities;
		</style>
	</head>
	<body class="bg-white text-zinc-900">
		<slot />
	</body>
</html>
